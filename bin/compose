#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
default_config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}"
export EVENT_MAP_SECRETS_DIR="${EVENT_MAP_SECRETS_DIR:-${default_config_dir}/event-map/secrets}"
engine="${CONTAINER_ENGINE:-docker}"
case "$engine" in docker|podman) ;; *) echo 'BLOCKED: CONTAINER_ENGINE must be docker or podman.' >&2; exit 2 ;; esac
if [[ "$engine" == podman ]]; then
  export PODMAN_COMPOSE_PROVIDER="${PODMAN_COMPOSE_PROVIDER:-podman-compose}"
fi
command -v "$engine" >/dev/null || { echo 'BLOCKED: selected container engine unavailable.' >&2; exit 2; }
cd "${repo_dir}"
exec python3 "${repo_dir}/bin/stack_lock.py" "$engine" compose "$@"

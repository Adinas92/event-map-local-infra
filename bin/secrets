#!/usr/bin/env bash
set -euo pipefail

default_config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}"
secrets_root="${EVENT_MAP_SECRETS_DIR:-${default_config_dir}/event-map/secrets}"

usage() {
  echo "Użycie: $0 init|list|set <service> <name>|remove <service> <name>" >&2
  exit 2
}

validate_service() {
  case "${1:-}" in
    event-ai|next-to-you|playwright) ;;
    *) echo "Nieobsługiwany serwis: ${1:-<brak>}" >&2; exit 2 ;;
  esac
}

validate_name() {
  case "${1:-}:${2:-}" in
    event-ai:OPENAI_API_KEY|event-ai:OPENROUTER_API_KEY|event-ai:GROQ_API_KEY|event-ai:GOOGLE_AI_STUDIO_API_KEY|event-ai:QDRANT_API_KEY|event-ai:NTY_INGESTION_OAUTH_CLIENT_ID|event-ai:NTY_INGESTION_OAUTH_CLIENT_SECRET|event-ai:NTY_MCP_OAUTH_CLIENT_ID|event-ai:NTY_MCP_OAUTH_CLIENT_SECRET|next-to-you:NTY_EVENTMAP_AI_OAUTH_CLIENT_ID|next-to-you:NTY_EVENTMAP_AI_OAUTH_CLIENT_SECRET|next-to-you:APP_AUTH_TOKEN_SECRET|next-to-you:oauth_google_client_id|next-to-you:oauth_google_client_secret|playwright:PLAYWRIGHT_AUTH_EMAIL|playwright:PLAYWRIGHT_AUTH_PASSWORD) ;;
    *) echo "Niedozwolony sekret dla ${1:-<brak>}: ${2:-<brak>}" >&2; exit 2 ;;
  esac
}

init_dirs() {
  umask 077
  mkdir -p "${secrets_root}/event-ai" "${secrets_root}/next-to-you" "${secrets_root}/playwright"
  chmod 700 "${secrets_root}" "${secrets_root}/event-ai" "${secrets_root}/next-to-you" "${secrets_root}/playwright"

  local app_auth_secret="${secrets_root}/next-to-you/APP_AUTH_TOKEN_SECRET"
  if [[ ! -s "${app_auth_secret}" ]]; then
    command -v openssl >/dev/null 2>&1 || {
      echo "Brak openssl; nie można wygenerować lokalnego APP_AUTH_TOKEN_SECRET." >&2
      exit 1
    }
    openssl rand -base64 64 > "${app_auth_secret}"
    chmod 600 "${app_auth_secret}"
    echo "Wygenerowano lokalny next-to-you/APP_AUTH_TOKEN_SECRET (wartość ukryta)."
  fi
}

command="${1:-}"
case "${command}" in
  init)
    init_dirs
    echo "Katalogi sekretów są gotowe: ${secrets_root}"
    ;;
  list)
    init_dirs
    for service in event-ai next-to-you playwright; do
      echo "${service}:"
      find "${secrets_root}/${service}" -maxdepth 1 -type f -exec basename {} \; | LC_ALL=C sort | sed 's/^/  - /'
    done
    ;;
  set)
    service="${2:-}"
    name="${3:-}"
    validate_service "${service}"
    validate_name "${service}" "${name}"
    init_dirs
    read -r -s -p "Wartość ${service}/${name}: " value
    echo
    if [[ -z "${value}" ]]; then
      echo "Pusta wartość nie została zapisana." >&2
      exit 1
    fi
    umask 077
    printf '%s' "${value}" > "${secrets_root}/${service}/${name}"
    unset value
    chmod 600 "${secrets_root}/${service}/${name}"
    echo "Zapisano ${service}/${name} (wartość ukryta)."
    ;;
  remove)
    service="${2:-}"
    name="${3:-}"
    validate_service "${service}"
    validate_name "${service}" "${name}"
    target="${secrets_root}/${service}/${name}"
    if [[ -e "${target}" ]]; then
      rm -f -- "${target}"
      echo "Usunięto ${service}/${name}."
    else
      echo "Brak ${service}/${name}; bez zmian."
    fi
    ;;
  *) usage ;;
esac

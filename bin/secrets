#!/usr/bin/env bash
set -euo pipefail

default_config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}"
secrets_root="${EVENT_MAP_SECRETS_DIR:-${default_config_dir}/event-map/secrets}"
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest_file="${repo_dir}/config/secrets-manifest.tsv"

usage() {
  echo "Użycie: $0 init|status|check <core|full-ai|e2e-auth>|set <service> <name>|remove <service> <name>" >&2
  exit 2
}

validate_service() {
  case "${1:-}" in
    event-ai|next-to-you|playwright) ;;
    *) echo "Nieobsługiwany serwis: ${1:-<brak>}" >&2; exit 2 ;;
  esac
}

validate_name() {
  awk -F '\t' -v service="${1:-}" -v name="${2:-}" '
    $1 == service && $2 == name { found = 1 }
    END { exit(found ? 0 : 1) }
  ' "${manifest_file}" || {
    echo "Niedozwolony sekret dla ${1:-<brak>}: ${2:-<brak>}" >&2
    exit 2
  }
}

init_dirs() {
  umask 077
  mkdir -p "${secrets_root}/event-ai" "${secrets_root}/next-to-you" "${secrets_root}/playwright"
  chmod 700 "${secrets_root}" "${secrets_root}/event-ai" "${secrets_root}/next-to-you" "${secrets_root}/playwright"

  local app_auth_secret="${secrets_root}/next-to-you/APP_AUTH_TOKEN_SECRET"
  if [[ ! -s "${app_auth_secret}" ]]; then
    command -v openssl >/dev/null 2>&1 || {
      echo "Brak openssl; nie można wygenerować lokalnego APP_AUTH_TOKEN_SECRET." >&2
      exit 1
    }
    openssl rand -base64 64 > "${app_auth_secret}"
    chmod 600 "${app_auth_secret}"
    echo "Wygenerowano lokalny next-to-you/APP_AUTH_TOKEN_SECRET (wartość ukryta)."
  fi
}

print_status() {
  printf '%-14s %-42s %-12s %s\n' "SERVICE" "SECRET" "PROFILE" "STATUS"
  while IFS=$'\t' read -r service name profile description; do
    [[ -z "${service}" || "${service}" == \#* ]] && continue
    if [[ -s "${secrets_root}/${service}/${name}" ]]; then
      status="SET"
    else
      status="MISSING"
    fi
    printf '%-14s %-42s %-12s %s\n' "${service}" "${name}" "${profile}" "${status}"
  done < "${manifest_file}"
}

check_profile() {
  local requested="${1:-core}"
  local missing=0
  local provider_set=0

  case "${requested}" in
    core|full-ai|e2e-auth) ;;
    *) echo "Nieobsługiwany profil: ${requested}" >&2; exit 2 ;;
  esac

  while IFS=$'\t' read -r service name profile description; do
    [[ -z "${service}" || "${service}" == \#* ]] && continue
    [[ "${profile}" == "ai-provider" && -s "${secrets_root}/${service}/${name}" ]] && provider_set=1

    required=0
    [[ "${profile}" == "core" ]] && required=1
    [[ "${requested}" == "full-ai" && "${profile}" == "full-ai" ]] && required=1
    [[ "${requested}" == "e2e-auth" && "${profile}" == "e2e-auth" ]] && required=1
    if [[ "${required}" == 1 && ! -s "${secrets_root}/${service}/${name}" ]]; then
      echo "MISSING ${service}/${name} — ${description}"
      missing=1
    fi
  done < "${manifest_file}"

  if [[ "${requested}" == "full-ai" && "${provider_set}" == 0 ]]; then
    echo "MISSING ai-provider — ustaw co najmniej jeden klucz providera z manifestu."
    missing=1
  fi

  if [[ "${missing}" == 0 ]]; then
    echo "Profil ${requested}: gotowy."
    return 0
  fi
  echo "Profil ${requested}: wymaga uzupełnienia powyższych nazw." >&2
  return 1
}

command="${1:-}"
case "${command}" in
  init)
    init_dirs
    echo "Katalogi sekretów są gotowe: ${secrets_root}"
    ;;
  status|list)
    init_dirs
    print_status
    ;;
  check)
    init_dirs
    check_profile "${2:-core}"
    ;;
  set)
    service="${2:-}"
    name="${3:-}"
    validate_service "${service}"
    validate_name "${service}" "${name}"
    init_dirs
    read -r -s -p "Wartość ${service}/${name}: " value
    echo
    if [[ -z "${value}" ]]; then
      echo "Pusta wartość nie została zapisana." >&2
      exit 1
    fi
    umask 077
    printf '%s' "${value}" > "${secrets_root}/${service}/${name}"
    unset value
    chmod 600 "${secrets_root}/${service}/${name}"
    echo "Zapisano ${service}/${name} (wartość ukryta)."
    ;;
  remove)
    service="${2:-}"
    name="${3:-}"
    validate_service "${service}"
    validate_name "${service}" "${name}"
    target="${secrets_root}/${service}/${name}"
    if [[ -e "${target}" ]]; then
      rm -f -- "${target}"
      echo "Usunięto ${service}/${name}."
    else
      echo "Brak ${service}/${name}; bez zmian."
    fi
    ;;
  *) usage ;;
esac

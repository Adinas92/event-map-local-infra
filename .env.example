# Wyłącznie ustawienia niesekretne. Sekrety ustawiaj przez `make secrets-set`.
COMPOSE_PROJECT_NAME=event-map-local

# Opcjonalne ścieżki do checkoutów/worktree.
EVENT_AI_PATH=../event-ai
NEXT_TO_YOU_PATH=../next-to-you
NEXT_TO_YOU_UI_PATH=../next-to-you-ui

# Opcjonalny katalog poza repo. Gdy brak, helper używa ~/.config/event-map/secrets.
# EVENT_MAP_SECRETS_DIR=/bezpieczna/sciezka/event-map/secrets

# Klucz CARTO Basemaps dla mapy w przeglądarce. Wartość tylko w lokalnym .env.
# CARTO_BASEMAPS_API_KEY=

POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
MAILHOG_SMTP_PORT=4220
MAILHOG_UI_PORT=8025
EVENT_AI_PORT=8000
NEXT_TO_YOU_PORT=8100
NEXT_TO_YOU_UI_PORT=4200

LLM_PROVIDER=ollama
AI_SEARCH_ENABLED=true
AI_SEARCH_REDIS_ENABLED=true

# Niesekretna konfiguracja OAuth dla pełnego AI flow. Wypełnij dla własnego tenant-a.
NTY_MCP_OAUTH_TOKEN_URL=
NTY_MCP_OAUTH_AUDIENCE=
